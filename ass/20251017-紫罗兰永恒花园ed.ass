Comment: 0,0:00:00.61,0:00:00.84,Default,动态位置字计算函数,0,0,0,code once,function calculate_syl_pos_offset(line, syl, line_start_frame, j)    local current_time =  frame_to_time(line_start_frame + j - 1, 24000/ 1001)    if current_time >= line.start_time + syl.start_time and current_time < line.start_time + syl.start_time + syl.duration / 2 then        return (current_time - line.start_time - syl.start_time) * 10 / (syl.duration / 2)    elseif current_time >= line.start_time + syl.start_time + syl.duration / 2 and current_time <= line.start_time + syl.end_time then        return (line.start_time + syl.end_time - current_time) * 10 / (syl.duration / 2)    else        return 0    end end
